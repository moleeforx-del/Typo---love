<!DOCTYPE html><!--_DwrT1yiV8gDhapFBK8G3--><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><link rel="preload" href="/_next/static/media/38df7484fe560b25-s.p.60f15535.woff2" as="font" crossorigin="" type="font/woff2"><link rel="preload" href="/_next/static/media/7ebf22b5a21034f8-s.p.d8bad3ab.woff2" as="font" crossorigin="" type="font/woff2"><link rel="preload" href="/_next/static/media/a9a434ecf764164f-s.p.73974b4a.woff2" as="font" crossorigin="" type="font/woff2"><link rel="preload" href="/_next/static/media/e41d5df559864f9e-s.p.380d09ea.woff2" as="font" crossorigin="" type="font/woff2"><link rel="preload" href="/_next/static/media/f5031e7b18bdfbb3-s.p.3dcbbce0.woff2" as="font" crossorigin="" type="font/woff2"><link rel="stylesheet" href="css/11af73eb55854e92.css" data-precedence="next"><link rel="preload" as="script" fetchpriority="low" href="/_next/static/chunks/f1b4d49aa9e249c5.js"><script src="js/d7c7e524fedad6b6.js" async=""></script><script src="js/cf9c3f1512e839dd.js" async=""></script><script src="js/7d6514a90169e63d.js" async=""></script><script src="js/82abf2d65f5428ae.js" async=""></script><script src="js/turbopack-4c6257fcbe845bb0.js" async=""></script><script src="js/9c152453eabc6e48.js" async=""></script><script src="js/dfd98513be7e436a.js" async=""></script><script src="js/ff1a16fafef87110.js" async=""></script><script src="js/d2be314c3ece3fbe.js" async=""></script><script src="js/77f1630c96372cf1.js" async=""></script><script src="js/7fbff105c0a5b464.js" async=""></script><script src="js/b6071be0e0398e05.js" async=""></script><meta name="next-size-adjust" content=""><title>typo.love — a digital library of love letters</title><meta name="description" content="for all the words left unsaid. a project by @lychkel"><meta property="og:title" content="typo.love — a digital library of love letters"><meta property="og:description" content="for all the words left unsaid. a project by @lychkel"><