L0VkIFNoZWVyYW4gLSBMZWdvIEhvdXNlIChMeXJpYyBWaWRlbykubXAzIiwic2NvcGUiOiJkb3dubG9hZCIsImlhdCI6MTc4MTM1NzI3NiwiZXhwIjoyMDY1MTgxMjc2fQ.Lx8hpLWDKsDatHGyhg843QEay4-3ntMAR2cBXosRidI\",\"thumbnail_url\":null,\"created_at\":\"2025-06-02T10:56:45+00:00\",\"cover_image\":\"https://tbwqrdimtyoqsbteejna.supabase.co/storage/v1/object/sign/envelopes/20.avif?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hMjBiNzMxZS04OWU0LTQ5OTYtYjAxNi1mYWYyMmMwZjk0ZGUiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJlbnZlbG9wZXMvMjAuYXZpZiIsInNjb3BlIjoiZG93bmxvYWQiLCJpYXQiOjE3ODEzNTc0ODcsImV4cCI6MjA2NTE4MTQ4N30.QIJGoetOKgsRUic6zxAs7eMPhDsAjt9FTepqMCOr0k8\",\"background_image\":\"https://tbwqrdimtyoqsbteejna.supabase.co/storage/v1/object/sign/backgrounds/20-real.png?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hMjBiNzMxZS04OWU0LTQ5OTYtYjAxNi1mYWYyMmMwZjk0ZGUiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJiYWNrZ3JvdW5kcy8yMC1yZWFsLnBuZyIsInNjb3BlIjoiZG93bmxvYWQiLCJpYXQiOjE3ODE0Njg3NDcsImV4cCI6MjA2NTI5Mjc0N30.rJvYFM2az3LXvQU7-DlZX1f5Oj4lwRgJpz45Bt4qyoA\",\"polaroid_image\":\"https://tbwqrdimtyoqsbteejna.supabase.co/storage/v1/object/sign/polaroid-images/20.png?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hMjBiNzMxZS04OWU0LTQ5OTYtYjAxNi1mYWYyMmMwZjk0ZGUiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJwb2xhcm9pZC1pbWFnZXMvMjAucG5nIiwic2NvcGUiOiJkb3dubG9hZCIsImlhdCI6MTc4MTM3MjU3NiwiZXhwIjoyMDY1MTk2NTc2fQ.CS20r7J-LzjRbfQwwKE1rLVbPSTck-QgnWBvKLEitPg\",\"song_name\":\"Lego House by Ed Sheeran\",\"accent_color\":\"#5FAAE0\",\"text_color\":\"#5FAAE0\",\"frosted_fill_color\":\"#FFF4FD\",\"volume\":1},{\"id\":\"21\",\"slug\":\"forever\",\"title\":\"forever\",\"author\":null,\"recipient\":null,\"body\":\"My Love,\\n\\nI’m scared to wake up in the morning that there will be no you anymore. I’m scared to hear a song that reminds me of you because I might just suddenly cry. I’m scared to think all the plans we have for our future will not go as we planned. I’m scared that you’ll just be a person I once loved wholeheartedly. I’m scared, truly. I don’t even know what to do or what to think, my mind will only be filled with emptiness. My heart will shatter, each pieces will be lost every time I thought of you. I could never love someone as much as I’ve loved you. All the things that reminded me of you will be just a memory stored in me, and I don’t ever want that to be just a memory waiting to be forgotten. \",\"audio_url\":\"https://tbwqrdimtyoqsbteejna.supabase.co/storage/v1/object/sign/love-songs/The%20Black%20Skirts%20-%20EVERYTHING.mp3?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hMjBiNzMxZS04OWU0LTQ5OTYtYjAxNi1mYWYyMmMwZjk0ZGUiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJsb3ZlLXNvbmdzL1RoZSBCbGFjayBTa2lydHMgLSBFVkVSWVRISU5HLm1wMyIsInNjb3BlIjoiZG93bmxvYWQiLCJpYXQiOjE3ODEzNTcyNDEsImV4cCI6MjA2NTE4MTI0MX0.qqyYBfJMN42gMSXMjBubfiiYP32QrYzKlpq6dNeYozQ\",\"thumbnail_url\":null,\"created_at\":\"2025-06-16T07:35:26+00:00\",\"cover_image\":\"https://tbwqrdimtyoqsbteejna.supabase.co/storage/v1/object/sign/envelopes/21.avif?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hMjBiNzMxZS04OWU0LTQ5OTYtYjAxNi1mYWYyMmMwZjk0ZGUiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJlbnZlbG9wZXMvMjEuYXZpZiIsInNjb3BlIjoiZG93bmxvYWQiLCJpYXQiOjE3ODEzNTc1MDEsImV4cCI6MjA2NTE4MTUwMX0.GjGs2PEniE9INayEfi5PGPga79QoRiKUNhLITwHk9MU\",\"background_image\":\"https://tbwqrdimtyoqsbteejna.supabase.co/storage/v1/object/sign/backgrounds/21-real.png?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hMjBiNzMxZS04OWU0LTQ5OTYtYjAxNi1mYWYyMmMwZjk0ZGUiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJiYWNrZ3JvdW5kcy8yMS1yZWFsLnBuZyIsInNjb3BlIjoiZG93bmxvYWQiLCJpYXQiOjE3ODE0Njg3NjMsImV4cCI6MjA2NTI5Mjc2M30.OTPjuQTBo_zNeyf_Kk9GQldL5q2eecxKfeLEQAFpBN8\",\"polaroid_image\":\"https://tbwqrdimtyoqsbteejna.supabase.co/storage/v1/object/sign/polaroid-images/21.png?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hMjBiNzMxZS04OWU0LTQ5OTYtYjAxNi1mYWYyMmMwZjk0ZGUiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJwb2xhcm9pZC1pbWFnZXMvMjEucG5nIiwic2NvcGUiOiJkb3dubG9hZCIsImlhdCI6MTc4MTM3MjU5NiwiZXhwIjoyMDY1MTk2NTk2fQ.6I_Nub44gEbwkXVnyBE0sVzDJMUYWEiZ3gCRGwiEMFI\",\"song_name\":\"EVERYTHING by The Black Skirts\",\"accent_color\":\"#2D352A\",\"text_color\":\"#BFECE4\",\"frosted_fill_color\":\"#2D352A\",\"volume\":1},{\"id\":\"22\",\"slug\":\"thought-of-you-on-the-bus-home\",\"title\":\"thought of you on the bus home\",\"author\":\"S\",\"recipient\":\"S\",\"body\":\"dear S,\\n\\ni hope you're well i hope you always are. you're full of magic \u0026 sweetness \u0026 tenderness. we've never met \u0026 that's so crazy. just the thought of you makes me feel sweet. you're filled with so much love it can't help but pour out of you in everything you say. i don't think i can tell you any of this anymore. does it make sense to be so hopelessly in love with someone you've never met? i know you never felt it the way i did \u0026 i don't blame you for a thing, all i have for you is the love of the whole world. you make it look so easy to be simply \u0026 unwaveringly loving. that i feel the love inside me too still. \u0026 i know it'll never be reciprocated \u0026 i'm comfortable with that. you're someone i will never forget. you used to say the same but i don't think it worked out. i hope we never meet. i wouldn't know what to say anymore if we did.\\n\\nlove, S\\nfrom miles \u0026 miles away\",\"audio_url\":\"https://tbwqrdimtyoqsbteejna.supabase.co/storage/v1/object/sign/love-songs/Trees%20and%20Flowers.mp3?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hMjBiNzMxZS04OWU0LTQ5OTYtYjAxNi1mYWYyMmMwZjk0ZGUiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJsb3ZlLXNvbmdzL1RyZWVzIGFuZCBGbG93ZXJzLm1wMyIsInNjb3BlIjoiZG93bmxvYWQiLCJpYXQiOjE3ODEzNTc1NzcsImV4cCI6MjA2NTE4MTU3N30._Cf7mwzecfapV1ryuUxA7PvVrzspofJqoMCyGJiQfso\",\"thumbnail_url\":null,\"created_at\":\"2025-06-16T11:02:59+00:00\",\"cover_image\":\"https://tbwqrdimtyoqsbteejna.supabase.co/storage/v1/object/sign/envelopes/22.avif?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hMjBiNzMxZS04OWU0LTQ5OTYtYjAxNi1mYWYyMmMwZjk0ZGUiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJlbnZlbG9wZXMvMjIuYXZpZiI