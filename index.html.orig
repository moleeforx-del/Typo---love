gin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}],false]}]}]]}],{\"children\":[[\"$\",\"$1\",\"c\",{\"children\":[\"$L7\",[[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/b6071be0e0398e05.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/7fbff105c0a5b464.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"$L8\",null,{\"children\":[\"$\",\"$9\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@a\"}]}]]}],{},null,false,false]},null,false,false],[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$Lb\",null,{\"children\":\"$Lc\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$Ld\",null,{\"children\":[\"$\",\"$9\",null,{\"name\":\"Next.Metadata\",\"children\":\"$Le\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],false]],\"m\":\"$undefined\",\"G\":[\"$f\",[]],\"S\":true}\n"])</script><script>self.__next_f.push([1,"c:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n"])</script><script>self.__next_f.push([1,"10:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/d2be314c3ece3fbe.js\"],\"IconMark\"]\na:null\n"])</script><script>self.__next_f.push([1,"e:[[\"$\",\"title\",\"0\",{\"children\":\"typo.love — a digital library of love letters\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"for all the words left unsaid. a project by @lychkel\"}],[\"$\",\"meta\",\"2\",{\"property\":\"og:title\",\"content\":\"typo.love — a digital library of love letters\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:description\",\"content\":\"for all the words left unsaid. a project by @lychkel\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:image\",\"content\":\"https://www.typo.love/opengraph-image.png?opengraph-image.c4959571.png\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:image:type\",\"content\":\"image/png\"}],[\"$\",\"meta\",\"8\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"9\",{\"name\":\"twitter:title\",\"content\":\"typo.love — a digital library of love letters\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:description\",\"content\":\"for all the words left unsaid. a project by @lychkel\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:image\",\"content\":\"https://www.typo.love/opengraph-image.png?opengraph-image.c4959571.png\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:image:type\",\"content\":\"image/png\"}],[\"$\",\"link\",\"15\",{\"rel\":\"icon\",\"href\":\"/icon.png?icon.57db27ed.png\",\"sizes\":\"512x512\",\"type\":\"image/png\"}],[\"$\",\"$L10\",\"16\",{}]]\n"])</script><script>self.__next_f.push([1,"11:I[57577,[\"/_next/static/chunks/9c152453eabc6e48.js\",\"/_next/static/chunks/dfd98513be7e436a.js\",\"/_next/static/chunks/b6071be0e0398e05.js\",\"/_next/static/chunks/7fbff105c0a5b464.js\"],\"default\"]\n12:T4fc,Dear Lunae, \n\n(this is how I will refer to you in this letter, I hope you don’t mind)\n\nThank you for being my first love. This is something that I do not have the courage to tell you. This is something that has been on my mind.\n\nYou showed me so much about myself when it comes to love when we were together. How I’d always write poems for you, how you inspired me to such heights. How I’d see this new side of you, such a romantic, how you admired every part of me. I wonder if you still do.\n\nYou said that love is transcendent, and that is true.\n\nYou said that my love is overwhelming, and that is also true.\n\nAnd I’d like to thank you for teaching that to me. I wish I could say it without it feeling awkward, but I still love you. Just in a different form now. I still love you. \n\nI’ve been reflecting on myself in this transition, in this moment. We’re both in such different paths of life, that even if it did work out, a lot of my faults would’ve shown. And I have a lot of growing to do. I really do.\n \nI do care a lot about you. I am wishing you well in everything that you do.\n\nThank you, again. We’ll be OK.\n\nLove, Solis\n\nP.S: If you ever do find this, I have two things to say. I’m sorry. And that everything will become beautiful again in time. 13:T442,—,\n\ni hate how popular sabrina carpenter is because everytime i hear please please please my heart sinks to my stomach. you don't know this, but i played this song on loop during hot summer days spent in an empty apartment with a broken AC. it quickly became my anthem to our breakup. \n\nthese days I've been replaying the last moments I saw you, how our goodbyes felt hesitant, how ~I wished you kissed me then~ we tried to hug out the awkwardness regardless.\n\ni know you had your reasons for leaving, and i'm not interested in being with someone who chose to leave me. but that doesn't mean i'll stop missing or loving you. i don't think i ever told you i loved you, even. still, i hope you felt it. \n\nyou know how prideful i am, so I hate to admit the grip you have on me, even now. it feels kind of silly honestly, so please ignore this if you're seeing someone new now. a part of me hopes you never see this and a part of me hopes you do.\n\n...you think we could still be homies?\n\nearnestly,\nclementine\n\np.s.  it'd be nice to see you again when i visit, at the place where we first met14:T5fb,"])</script><script>self.__next_f.push([1,"Dear you,\n\nI just wanted to say thank you for being a part of my life. We met in Grade 11 when you transferred in, barely knowing anyone. We started talking because we had a few classes together and were both in the tech crew. We’d always go back and forth with our usual friendly banter, making it seem like we couldn’t stand each other, but those moments always stuck with me.\n\nThanks for helping me with my CS homework and for always letting me bother you—especially when I needed to vent. Over the years, we drifted apart and reconnected more than once, but somehow, we always found our way back to hanging out. Some of my favourite memories are from our late-night drives, blasting music, and all the random places we went to.\n\nOne moment that still stands out was when we went to that concert for my favourite artist. I couldn’t decide between a t-shirt or a sweater, and you just went ahead and got me the sweater. It’s still one of my favourites to this day.\n\nI know you always saw me as a younger sister, and I was okay with that. But somewhere along the way, I started to see you differently. When you got a girlfriend, I was happy for you, but I also knew it meant we wouldn’t be hanging out as much. And when you told me you were leaving, it really hit me how much I was going to miss you.\n\nEven though life has taken us in different directions, I’ll always appreciate the time we spent together. Hopefully, one day, we’ll get to catch up again, even just as friends.\n\nWishing you all the best.\n\nLove, T"])</script><script>self.__next_f.push([1,"15:T420,Dear X,\n\nAlmost ten years ago, I bought a train ticket to your town just to see you. I was so in love. I thought you were my whole world. Years passed, and I remember believing I loved you, then believing I hated you. And then the war started, and I forgot about everything.\n\nSometimes, I wondered how you were. How was your mother? Was your black cat—whose name I’ve forgotten—still with you? I remember sending you a letter once, with a quote from Jane Eyre:\n\n\"I am no bird; and no net ensnares me; I am a free human being with an independent will.\"\n\nYou probably never even read it.\n\nNow, I find myself thinking that I hurt you more than you hurt me. What we had wasn’t love—we wounded each other, desperately, painfully. But I know I was cruel.\n\nYears have passed, and you haven't changed. You never left your town. I saw you. You are exactly the same. I thought you were dead to me, but when I saw you, I realized that the girl who once loved you so desperately no longer exists.\n\nYou were dead to me, but in reality, I was the one who died.16:T77b,"])</script><script>self.__next_f.push([1,"Dear Lici,\n\nI don't think anyone deserves a hug right now more than you do. \n\nIt's so weird and new how familiar you've gotten with the concept of loneliness. It has always been a foreign concept but now it's staring at you in the mirror.\nIt fills your mind, it eats your soul away, and it keeps dragging you down.\n\nYou know all the things you'd tell another, as to how to get out of this rut. But you also know it's a temporary fix. It's a cycle you keep coming back to and it hurts each time.\n\nI know you crave love. \nI know you crave a companion. You want someone to stand by your side. You want someone who helps you escape the loneliness. I know you do. I truly know you do but I also know you only deserve the best.\n\nI love you so much. \nYou are beautiful. You are sweet. You are kind. You are caring. I see how you think of everyone even when you are not in contact with them. You love people and want people to love you back, the way you do, if not harder. That shows how great of a person you are. Highly considerate and tender. \n\nYou don't deserve any less than the best and I need you to be patient. It's so hard, but I need you to be patient. The best person, the best people will come. You will be so immersed in love, you can barely escape it. \n\nCan you hold on to that future?\nCan you stand strong till we get there?\nCan you ensure you don't give in to loneliness?\nCan you wait just a bit more?\n\nLet's find other ways to escape the loneliness. Let's find other ways to enjoy being who we are and where we are. I don't know how but you are smart, you'd figure something out.\n\nI love you so so much and I can't wait for when you find the one that sweeps you off your feet, gives you flowers because they remind him of you, gives you the princess twirl because you are a princess, and makes you feel his love without a doubt in your mind.\n\nLet's be patient just as love is patient.\n\nWith All Love,\nLici."])</script><script>self.__next_f.push([1,"17:T727,"])</script><script>self.__next_f.push([1,"Dear Future Mother-in-law,\n\nIt's a bit of an odd letter, I don't even have a loml yet, and even that's not guaranteed.\nBut if I am lucky, I hope when I meet your very emotionally secure, deeply intelligent and handsome son, that I get to spend time with the woman that raised him as such.\n\nSo, could you show me how to make his favourite dish the way you do? We’ll cook together. I hope by the time we meet I’m better at it though. The other night, I facetimed my friends asking them to show me how to cook chicken for the first time. They were also largely appalled at my inability to cut vegetables correctly. I believe the only reason I haven’t cut my fingers is because my knives aren’t sharp enough.\n\nAlso could you show me his baby pictures? I know you love to talk about your family history. At the moment, I love sharing pictures of my younger sister. Often my friends show me pictures of their pets, I find it quite funny to show them pictures of a whole human being in return.\n\nActually, could you accompany me for some shopping? We are buying furniture for our new place. Right now I can’t even imagine having the money for that! It’ll be fun, and of course we can have a nice tea whilst out if you fancy.\n\n…\n……\n………\n\nWould you be able to tell I’m using him as an excuse? I figured mum’s are supposed to have an intuition for how their children really feel. \n\nIn which case, could we drop the in-law and can I just be a daughter?\n\n...\n\nThere's much more to say, but it's almost 4am and I'm tired. Until next time!!\n\nFrom your future daughter(-in-law)\n\nP.S. [Good Morning Call, S1.11, 32:10] [It’s Okay To Not Be Okay, S1.15, 57:54] [Crash Course In Romance, S1.2, 10.31] [Tangled, 1:28:53] [Mamma Mia, 1:19:00] [The Witcher, S2.3, 36:10] [Supergirl, S1.3, 7:00] [Modern Family, S5.12, 20:10]"])</script><script>self.__next_f.push([1,"18:T659,"])</script><script>self.__next_f.push([1,"Dear B,\n\nHow are you doing? I hope you're doing well. I miss how much we used to talk, and maybe, in my heart, I always kind of knew that this friendship might not last...\n\nI know we're still friends but maybe not as close as before but  that’s okay. I miss you you know? Some days, I see things that remind me of you—the very quality I love about myself causes me to miss you dearly.\n\nI really appreciate your encouragement this year, I truly do. I know you value authenticity a lot, but I still can’t help but wonder if the encouragement was fake. When I try to see myself through someone else’s eyes, I can’t help but think I look pathetic... the way I just keep waiting and waiting for you to reach back.\n\nWe’re still friends, but now our talks and chats make me feel more anxious and want to cry. It’s like waiting for a string to break. I haven’t told you any of this yet. Sometimes, I think being the oldest really makes being vulnerable hard...\n\nWe agreed to be honest, but I don’t know how to tell you that you make me feel like I matter less—that maybe I’m broken and worthless. And oh, how I wish you used more stickers and checked in more... Maybe the things that matter less to you really matter more to me.\n\nBut even so, I still can’t help but wish you're doing well and that you're truly happy.\n\nI still value our connection. There’s a lot left for me to learn in this world. Thank you for being a stepping stone and helping me get started.\n\nP.S: If you ever do find this, maybe reach back out to me. Maybe by then, I’ll have enough courage to tell you that it was me.\n\nLove,\n K🍓"])</script><script>self.__next_f.push([1,"7:[\"$\",\"$L11\",null,{\"letters\":[{\"id\":\"01\",\"slug\":\"dreamland\",\"title\":\"dreamland\",\"author\":\"9\",\"recipient\":\"7\",\"body\":\"to 7, \\n\\ni have a recurring dream that we're visiting you. every time, i come with different people. and every time, i don't know how we got up there. we're just there. it's empty at first, and then you appear. i bring your favourite cookies, we walk around and talk about what has changed. but i always wake up, i'm hundreds of kilometres away, and even if we went to where we remember you, i don't even know if you'd be there.\\n\\n9\",\"audio_url\":\"https://tbwqrdimtyoqsbteejna.supabase.co/storage/v1/object/sign/love-songs/In%20Dreamland%20Background%20Music.mp3?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hMjBiNzMxZS04OWU0LTQ5OTYtYjAxNi1mYWYyMmMwZjk0ZGUiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJsb3ZlLXNvbmdzL0luIERyZWFtbGFuZCBCYWNrZ3JvdW5kIE11c2ljLm1wMyIsImlhdCI6MTc3MjM5MzEzNywiZXhwIjoyMDU2MjE3MTM3fQ.lQVsVeVTQUW6YQS7R1kcRWhQ4pWbaRJAB4bmgEPmF44\",\"thumbnail_url\":null,\"created_at\":\"2025-02-08T18:04:07+00:00\",\"cover_image\":\"https://tbwqrdimtyoqsbteejna.supabase.co/storage/v1/object/sign/envelopes/01.avif?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hMjBiNzMxZS04OWU0LTQ5OTYtYjAxNi1mYWYyMmMwZjk0ZGUiLCJhbGciOiJIUzI